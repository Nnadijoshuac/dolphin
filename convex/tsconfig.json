{
  /* This TypeScript project config describes the environment that
   * Convex functions run in and is used to typecheck them.
   * You can modify it, but some settings are required to use Convex.
   */
  "compilerOptions": {
    /* These settings are not required by Convex and can be modified. */
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    /* Needed since the SDK 57 upgrade brought TypeScript 6, which no longer
     * pulls in every @types/* package automatically the way TS 5 did. Without
     * this, `npx convex dev` fails its pre-push typecheck with ten
     * "Cannot find name 'process'" errors across five modules whose
     * process.env reads date from August and were fine under TS 5, so nothing
     * could be deployed at all. @types/node is present (26.3.0), it just has
     * to be named now. Verified: `tsc -p convex/tsconfig.json --types node`
     * exits 0 where the same command without it reports the ten errors. */
    "types": ["node"],

    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["./_generated"]
}
