# Convex deployment the website reads its agent catalog from
# (convex/agents.ts's listAgents). Must point at the SAME deployment as the
# mobile app's EXPO_PUBLIC_CONVEX_URL - that is what makes the two surfaces
# show identical data. Printed by `npx convex dev` at the repo root.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional. BSC mainnet RPC used for the on-chain ERC-8004 registry check in
# src/services/chain.ts. The public default works but is rate-limited.
NEXT_PUBLIC_BSC_RPC_URL=

# 8004scan API for agent discovery and detail fetches
NEXT_PUBLIC_8004SCAN_API_BASE_URL=
