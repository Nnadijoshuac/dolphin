# EXPO_PUBLIC_* values are embedded in the client bundle. Never put private keys,
# seed phrases, signing secrets, or server-only credentials in these variables.
EXPO_PUBLIC_REOWN_PROJECT_ID=
EXPO_PUBLIC_BSC_RPC_URL=
EXPO_PUBLIC_8004SCAN_API_BASE_URL=

# Convex backend URL for category-stats aggregation (convex/). Set after
# running `npx convex dev` once, which requires an interactive login -
# see README.md.
EXPO_PUBLIC_CONVEX_URL=

# Backend-only environment variables (never use EXPO_PUBLIC_* prefix for these)
BSC_RPC_URL=
SCAN8004_API_URL=
