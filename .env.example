# EXPO_PUBLIC_* values are embedded in the client bundle. Never put private keys,
# seed phrases, signing secrets, or server-only credentials in these variables.
EXPO_PUBLIC_REOWN_PROJECT_ID=
EXPO_PUBLIC_BSC_RPC_URL=
EXPO_PUBLIC_8004SCAN_API_BASE_URL=

# Convex backend URL for category-stats aggregation (convex/). Set after
# running `npx convex dev` once, which requires an interactive login -
# see README.md.
EXPO_PUBLIC_CONVEX_URL=

# Backend-only environment variables (never use EXPO_PUBLIC_* prefix for these)
BSC_RPC_URL=
SCAN8004_API_URL=

# Relying-party domain for Altana passkeys (WebAuthn). Must match the domain
# hosting apple-app-site-association / assetlinks.json - see
# src/wallet/altana-rp-id.ts.
EXPO_PUBLIC_ALTANA_RP_ID=

# ---------------------------------------------------------------------------
# Liquidation alerts (Convex deployment env, NOT this file at runtime)
# ---------------------------------------------------------------------------
# Set these with `npx convex env set <NAME> <value>`, not in a .env file -
# convex/healthAlerts.ts reads them inside the Convex runtime, where a local
# .env is not present. They are listed here so the set is discoverable.
#
# Without RESEND_API_KEY the alert cron is a no-op and the signup panel does
# not render at all, which is deliberate: a form that accepts an address and
# silently never delivers is worse than no form.
#
# RESEND_API_KEY   - from resend.com. Free tier is ~3k emails/month.
# ALERT_FROM_EMAIL - optional. Must be a sender on a domain VERIFIED in Resend;
#                    Resend rejects anything else. Defaults to
#                    "Dolphin <alerts@dolphinamp.com>".
# SITE_URL         - optional. Origin used for the links inside an alert email,
#                    including the one-click unsubscribe. Defaults to the
#                    production Vercel origin.
