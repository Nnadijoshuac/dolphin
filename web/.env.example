# Every NEXT_PUBLIC_* value here is inlined into the browser bundle by design.
# None of them is a secret, and none of them may become one. The project's one
# real secret (SCAN8004_API_KEY) is Convex-side only and is never read here.
#
# These same values are configured in TWO other places, and all three must
# agree: the Vercel project settings (which is what production actually uses)
# and the env block in .github/workflows/build-web-site.yml. See web/README.md.

# Convex deployment the website reads its agent catalog from (convex/agents.ts).
# Must point at the SAME deployment as the mobile app's EXPO_PUBLIC_CONVEX_URL -
# that is what makes the two surfaces show identical data. Printed by
# `npx convex dev` at the repo root.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional. BSC mainnet RPC used for the on-chain ERC-8004 registry check in
# src/services/chain.ts and for the reputation-registry write in
# src/services/reputation-registry.ts. The public default works but is
# rate-limited; a dedicated endpoint is strongly preferred in production.
NEXT_PUBLIC_BSC_RPC_URL=

# Optional. Absolute origin of this deployment, used for canonical URLs,
# sitemap.xml, robots.txt and OpenGraph image URLs. Defaults to the production
# origin. Leave UNSET on preview deployments - a preview that advertises itself
# as canonical will compete with production in search results.
NEXT_PUBLIC_SITE_URL=

# Optional. Reown (WalletConnect) Cloud project id, for QR pairing with mobile
# wallets - src/wallet/wallet-provider.tsx. Without it, only injected
# (browser-extension) wallets can connect.
NEXT_PUBLIC_REOWN_PROJECT_ID=
