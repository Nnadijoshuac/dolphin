{
  "expo": {
    "name": "Dolphin",
    "slug": "Dolphin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dolphin",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F4EE",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nnadijoshuac.dolphin",
      "supportsTablet": true,
      "associatedDomains": [
        "webcredentials:nnadijoshuac.github.io"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "safe",
          "rainbow",
          "uniswap"
        ]
      }
    },
    "android": {
      "package": "com.nnadijoshuac.dolphin",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0E",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F4EE",
          "image": "./assets/images/dolphin-loading.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-font",
      "expo-image",
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ],
      "expo-web-browser",
      "./queries.js"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "a3bcb0c1-ff0e-463f-8a52-d9958c829088"
      }
    },
    "owner": "serenityeye"
  }
}
